<?xml version="1.0" encoding="utf-8"?>
<!-- About 4x1 by default, down to 2x1 and up as tall as anyone likes.
     Never under 56dp tall: the 48dp buttons plus the card's padding. A
     launcher with cells shorter than that gives the card two rows rather
     than clipping its targets.
     No updatePeriodMillis: the app pushes every change itself, and a
     timer would wake the phone for nothing. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_trellis"
    android:minWidth="250dp"
    android:minHeight="56dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="56dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_trellis"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
